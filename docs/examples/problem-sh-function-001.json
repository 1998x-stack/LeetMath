        "solutions": [
          {
            "type": "worked",
            "review_state": "sample_unreviewed",
            "steps": [
              "(x\\ln x)'=\\ln x+1",
              "(-ax)'=-a",
              "因此 f'(x)=\\ln x+1-a"
            ]
          }
        ]
      },
      {
        "id": "3d0108d3-dc46-4c44-a38f-cdc183e51002",
        "logical_part_id": "d6d43969-b93a-452d-b271-3e731b6f1002",
        "part_key": "2",
        "display_order": 2,
        "response_type": "derivation",
        "max_score": "5.00",
        "prompt": {
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "text": "讨论函数的单调性，并求最小值。"
                }
              ]
            }
          ]
        },
        "answer_spec": {
          "spec_version": 1,
          "grading_mode": "manual",
          "checker_type": "rubric_manual",
          "expected_latex": "x_0=e^{a-1};\\ f_{\\min}=-e^{a-1}",
          "constraints": {
            "x": "positive",
            "a": "real"
          }
        },
        "rubric": {
          "version": 1,
          "criteria": [
            {
              "id": "P2-C1",
              "description": "由 f'(x)=0 得 x=e^{a-1}",
              "max_points": "2.00"
            },
            {
              "id": "P2-C2",
              "description": "确定在 (0,e^{a-1}) 递减、(e^{a-1},+∞) 递增",
              "max_points": "2.00"
            },
            {
              "id": "P2-C3",
              "description": "最小值为 -e^{a-1}",
              "max_points": "1.00"
            }
          ]
        },
        "solutions": [
          {
            "type": "worked",
            "review_state": "sample_unreviewed",
            "steps": [
              "f'(x)=\\ln x+1-a",
              "当 0<x<e^{a-1} 时 f'(x)<0；当 x>e^{a-1} 时 f'(x)>0",
              "故在 x=e^{a-1} 处取得最小值 -e^{a-1}"
            ]
          }
        ]
      },
      {
        "id": "3d0108d3-dc46-4c44-a38f-cdc183e51003",
        "logical_part_id": "d6d43969-b93a-452d-b271-3e731b6f1003",
        "part_key": "3",
        "display_order": 3,
        "response_type": "proof",
        "max_score": "6.00",
        "prompt": {
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "text": "证明：对任意 "
                },
                {
                  "type": "inline_math",
                  "latex": "x>0,\\ a\\in\\mathbb R"
                },
                {
                  "type": "text",
                  "text": "，有 "
                },
                {
                  "type": "inline_math",
                  "latex": "x\\ln x-ax\\geq-e^{a-1}"
                },
                {
                  "type": "text",
                  "text": "。"
                }
              ]
            }
          ]
        },
        "answer_spec": {
          "spec_version": 1,
          "grading_mode": "manual",
          "checker_type": "rubric_manual",
          "expected_latex": "x\\ln x-ax\\geq-e^{a-1}",
          "equality_case": "x=e^{a-1}"
        },
        "rubric": {
          "version": 1,
          "criteria": [
            {
              "id": "P3-C1",
              "description": "由导数证明函数在 x=e^{a-1} 取最小值",
              "max_points": "3.00"
            },
            {
              "id": "P3-C2",
              "description": "讨论 x>0 与 a∈R 的适用域",
              "max_points": "1.00"
            },
            {
              "id": "P3-C3",
              "description": "推导不等式并指出等号成立条件",
              "max_points": "2.00"
            }
          ]
        },
        "solutions": [
          {
            "type": "proof",
            "review_state": "sample_unreviewed",
            "steps": [
              "由第二问可知对任意 x>0，f(x)\\geq f(e^{a-1})",
              "f(e^{a-1})=e^{a-1}(a-1)-a e^{a-1}=-e^{a-1}",
              "所以 x\\ln x-ax\\geq-e^{a-1}，等号当且仅当 x=e^{a-1}"
            ]
          }
        ]
      }
    ]
