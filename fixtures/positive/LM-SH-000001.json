        "answer_spec": {
          "spec_version": 1,
          "grading_mode": "manual",
          "checker_type": "rubric_manual",
          "expected_latex": "x\\ln x-ax\\geq-e^{a-1}",
          "equality_case": "x=e^{a-1}"
        },
        "rubric": {
          "version": 1,
          "criteria": [
            {
              "id": "P3-C1",
              "description": "由导数证明函数在 x=e^{a-1} 取最小值",
              "max_points": "3.00"
            },
            {
              "id": "P3-C2",
              "description": "讨论 x>0 与 a∈R 的适用域",
              "max_points": "1.00"
            },
            {
              "id": "P3-C3",
              "description": "推导不等式并指出等号成立条件",
              "max_points": "2.00"
            }
          ]
        },
        "solutions": [
          {
            "type": "proof",
            "review_state": "reviewed",
            "steps": [
              "由第二问可知对任意 x>0，f(x)\\geq f(e^{a-1})",
              "f(e^{a-1})=e^{a-1}(a-1)-a e^{a-1}=-e^{a-1}",
              "所以 x\\ln x-ax\\geq-e^{a-1}，等号当且仅当 x=e^{a-1}"
            ]
          }
        ],
        "knowledge_codes": [
          "DERIV-MONOTONIC",
          "INEQUALITY"
        ],
        "reasoning_steps": [
          {
            "semantic_key": "use_minimum",
            "order": 1,
            "recall_cue": "要证的不等式右边 −e^{a−1} 看起来像什么？如何借用第二问？",
            "reference_latex": "\\forall x>0:\\ f(x)\\ge f(e^{a-1})",
            "explanation": "不等式即“函数值 ≥ 最小值”。",
            "max_points": "3.00",
            "criticality": "key",
            "knowledge_codes": [
