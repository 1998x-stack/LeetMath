              "spans": [
                {
                  "type": "text",
                  "text": "讨论函数的单调性，并求最小值。"
                }
              ]
            }
          ]
        },
        "answer_spec": {
          "spec_version": 1,
          "grading_mode": "manual",
          "checker_type": "rubric_manual",
          "expected_latex": "x_0=e^{a-1};\\ f_{\\min}=-e^{a-1}",
          "constraints": {
            "x": "positive",
            "a": "real"
          }
        },
        "rubric": {
          "version": 1,
          "criteria": [
            {
              "id": "P2-C1",
              "description": "由 f'(x)=0 得 x=e^{a-1}",
              "max_points": "2.00"
            },
            {
              "id": "P2-C2",
              "description": "确定在 (0,e^{a-1}) 递减、(e^{a-1},+∞) 递增",
              "max_points": "2.00"
            },
            {
              "id": "P2-C3",
              "description": "最小值为 -e^{a-1}",
              "max_points": "1.00"
            }
          ]
        },
        "solutions": [
          {
            "type": "worked",
            "review_state": "reviewed",
            "steps": [
              "f'(x)=\\ln x+1-a",
              "当 0<x<e^{a-1} 时 f'(x)<0；当 x>e^{a-1} 时 f'(x)>0",
              "故在 x=e^{a-1} 处取得最小值 -e^{a-1}"
            ]
          }
        ],
        "knowledge_codes": [
          "DERIV-MONOTONIC"
        ],
        "reasoning_steps": [
          {
            "semantic_key": "critical_point",
            "order": 1,
            "recall_cue": "单调性的分界点从哪里来？令什么等于 0？",
            "reference_latex": "f'(x)=0\\iff\\ln x=a-1\\iff x=e^{a-1}",
            "explanation": "x>0 时 ln x 单调，方程有唯一解。",
            "max_points": "2.00",
            "criticality": "key",
            "knowledge_codes": [
              "DERIV-MONOTONIC"
            ]
          },
          {
            "semantic_key": "sign_analysis",
            "order": 2,
            "recall_cue": "在分界点两侧，f'(x) 的符号分别是什么？",
            "reference_latex": "0<x<e^{a-1}\\Rightarrow f'(x)<0;\\quad x>e^{a-1}\\Rightarrow f'(x)>0",
            "explanation": "f'(x)=ln x−(a−1) 关于 x 递增。",
            "max_points": "2.00",
            "criticality": "key",
            "knowledge_codes": [
              "DERIV-MONOTONIC"
            ]
          },
          {
            "semantic_key": "min_value",
            "order": 3,
            "recall_cue": "最小值是多少？把分界点代回原函数。",
            "reference_latex": "f(e^{a-1})=e^{a-1}(a-1)-ae^{a-1}=-e^{a-1}",
            "explanation": "先减后增 ⇒ 在分界点取最小值。",
            "max_points": "1.00",
            "criticality": "normal",
            "knowledge_codes": [
              "DERIV-MONOTONIC"
            ]
          }
        ]
      },
      {
        "id": "3d0108d3-dc46-4c44-a38f-cdc183e51003",
