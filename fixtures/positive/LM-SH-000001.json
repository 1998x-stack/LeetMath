        "solutions": [
          {
            "type": "worked",
            "review_state": "reviewed",
            "steps": [
              "(x\\ln x)'=\\ln x+1",
              "(-ax)'=-a",
              "因此 f'(x)=\\ln x+1-a"
            ]
          }
        ],
        "knowledge_codes": [
          "DERIV-RULES"
        ],
        "reasoning_steps": [
          {
            "semantic_key": "product_rule",
            "order": 1,
            "recall_cue": "x·ln x 是两个函数之积，第一步该用哪条求导法则？",
            "reference_latex": "(x\\ln x)'=1\\cdot\\ln x+x\\cdot\\frac{1}{x}=\\ln x+1",
            "explanation": "乘积法则 (uv)'=u'v+uv'。",
            "max_points": "1.00",
            "criticality": "normal",
            "knowledge_codes": [
              "DERIV-RULES"
            ]
          },
          {
            "semantic_key": "final_derivative",
            "order": 2,
            "recall_cue": "再处理 −ax 这一项，写出完整的 f'(x)。",
            "reference_latex": "f'(x)=\\ln x+1-a",
            "explanation": "(−ax)'=−a，与上一步相加。",
            "max_points": "2.00",
            "criticality": "key",
            "knowledge_codes": [
              "DERIV-RULES"
            ]
          }
        ]
      },
      {
        "id": "3d0108d3-dc46-4c44-a38f-cdc183e51002",
