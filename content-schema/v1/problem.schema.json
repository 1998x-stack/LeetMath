{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leetmath.dev/content-schema/v1/problem.schema.json",
  "title": "LeetMath Math Content Contract v1 — Problem document",
  "description": "Interchange format for one problem revision (docs/03-content-contract.md). Used by CMS, importers and fixtures.",
  "type": "object",
  "required": ["schema_version", "problem", "revision", "source_record_refs", "rights_policy_ref"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "sample_only": {"type": "boolean"},
    "problem": {
      "type": "object",
      "required": ["grade_band"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "display_id": {"type": "string", "pattern": "^LM-[A-Z0-9]+-[0-9]{6}$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 160},
        "grade_band": {"enum": ["primary", "junior_high", "senior_high", "undergrad", "graduate", "competition"]},
        "subject": {"const": "mathematics"},
        "visibility": {"enum": ["public", "private"]}
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": ["locale", "title", "shared_statement", "content_metadata", "parts"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "revision_no": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "in_math_review", "in_rights_review", "approved", "published", "archived", "retracted"]},
        "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "shared_statement": {"$ref": "#/$defs/MathRichText"},
        "content_metadata": {"$ref": "#/$defs/ContentMetadata"},
        "revision_kind": {"enum": ["initial", "semantic", "presentation"]},
        "change_note": {"type": "string"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 26, "items": {"$ref": "#/$defs/Part"}}
      },
      "additionalProperties": false
    },
    "source_record_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_code", "external_id"],
        "properties": {
          "source_code": {"type": "string", "minLength": 1},
          "external_id": {"type": "string", "minLength": 1},
          "external_revision": {"type": "string"},
          "record_kind": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "rights_policy_ref": {"type": "string", "minLength": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "sha256", "media_type"],
        "properties": {
          "asset_id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"enum": ["image/png", "image/jpeg", "image/svg+xml", "image/webp", "application/pdf"]},
          "license_ref": {"type": "string"}
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation_type", "target"],
        "properties": {
          "relation_type": {"enum": ["exact_duplicate", "adapted_from", "isomorphic_to", "translation_of", "prerequisite_to", "companion_of"]},
          "target": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Decimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "Span": {
      "oneOf": [
        {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "emphasis"}, "text": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "latex"], "properties": {"type": {"const": "inline_math"}, "latex": {"type": "string", "minLength": 1, "maxLength": 2000}, "alt_text": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "text", "href"], "properties": {"type": {"const": "link"}, "text": {"type": "string"}, "href": {"type": "string", "pattern": "^(https://|/)"}}, "additionalProperties": false}
      ]
    },
    "Spans": {"type": "array", "items": {"$ref": "#/$defs/Span"}},
    "Block": {
      "oneOf": [
        {"type": "object", "required": ["type", "spans"], "properties": {"type": {"const": "paragraph"}, "spans": {"$ref": "#/$defs/Spans"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "latex"], "properties": {"type": {"const": "display_math"}, "latex": {"type": "string", "minLength": 1, "maxLength": 4000}, "alt_text": {"type": "string"}, "canonical_expr": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "asset_id", "alt"], "properties": {"type": {"const": "image"}, "asset_id": {"type": "string"}, "alt": {"type": "string"}, "width": {"type": "integer"}, "height": {"type": "integer"}, "license_ref": {"type": "string"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "rows"], "properties": {"type": {"const": "table"}, "rows": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/Spans"}}}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "ordered", "items"], "properties": {"type": {"const": "list"}, "ordered": {"type": "boolean"}, "items": {"type": "array", "items": {"$ref": "#/$defs/Spans"}}}, "additionalProperties": false},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "diagram"}, "asset_id": {"type": "string"}, "alt": {"type": "string"}, "semantic_geometry": {"type": "object"}}, "additionalProperties": false}
      ]
    },
    "MathRichText": {
      "type": "object",
      "required": ["blocks"],
      "properties": {"blocks": {"type": "array", "items": {"$ref": "#/$defs/Block"}}},
      "additionalProperties": false
    },
    "ContentMetadata": {
      "type": "object",
      "properties": {
        "region_hints": {"type": "array", "items": {"type": "string"}},
        "grade_band": {"type": "string"},
        "platform_difficulty": {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": {"type": "integer", "minimum": 1, "maximum": 10},
            "origin": {"type": "string"},
            "rated_by": {"type": "string"},
            "confidence": {"type": "string"}
          }
        },
        "source_difficulty": {"type": "string"},
        "problem_type": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "estimated_minutes": {"type": "integer", "minimum": 1},
        "curriculum_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["curriculum_code", "release_code", "knowledge_code"],
            "properties": {
              "curriculum_code": {"type": "string"},
              "release_code": {"type": "string"},
              "knowledge_code": {"type": "string"},
              "relation_type": {"enum": ["tested", "related", "prerequisite"]},
              "weight": {"type": "number"}
            }
          }
        },
        "verified_exam": {"type": "boolean"},
        "verified_by": {"type": "string"},
        "verification_ref": {"type": "string"},
        "solution_visibility": {"enum": ["after_submit", "always", "teacher_release"]}
      },
      "additionalProperties": true
    },
    "Option": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,16}$"}, "content": {"$ref": "#/$defs/MathRichText"}},
      "additionalProperties": false
    },
    "AnswerSpec": {
      "type": "object",
      "required": ["spec_version", "grading_mode", "checker_type"],
      "properties": {
        "spec_version": {"type": "integer", "minimum": 1},
        "grading_mode": {"enum": ["automatic", "manual", "hybrid", "practice_only"]},
        "checker_type": {"enum": ["choice_exact", "choice_set", "integer_exact", "rational_exact", "decimal_tolerance", "symbolic_equivalence", "interval_set", "finite_set", "rubric_manual"]},
        "expected": {},
        "expected_latex": {"type": "string"},
        "canonical_expr": {"type": "string"},
        "assumptions": {"type": "object", "additionalProperties": {"enum": ["real", "positive", "negative", "nonnegative", "nonzero", "integer", "positive_integer"]}},
        "variables": {"type": "array", "items": {"type": "string"}},
        "tolerance": {"type": "object", "properties": {"abs": {"type": "string"}, "rel": {"type": "string"}}},
        "partial_credit": {"enum": ["none", "proportional"]},
        "unit": {"type": "string"},
        "golden_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["input", "expect"],
            "properties": {"input": {"type": "string"}, "expect": {"enum": ["accepted", "rejected", "partial", "invalid_response", "pending_review"]}}
          }
        }
      },
      "additionalProperties": true
    },
    "Rubric": {
      "type": "object",
      "required": ["criteria"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "policy": {"type": "string"},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "max_points"],
            "properties": {
              "id": {"type": "string"},
              "description": {"type": "string"},
              "max_points": {"$ref": "#/$defs/Decimal"},
              "evidence_required": {"type": "string"},
              "dependencies": {"type": "array", "items": {"type": "string"}},
              "mistake_codes": {"type": "array", "items": {"type": "string"}},
              "manual_or_auto": {"enum": ["manual", "auto"]}
            }
          }
        }
      }
    },
    "Solution": {
      "type": "object",
      "required": ["type", "steps"],
      "properties": {
        "type": {"enum": ["worked", "proof", "hint", "alternative"]},
        "review_state": {"type": "string"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "ReasoningStep": {
      "type": "object",
      "required": ["semantic_key", "order", "recall_cue", "reference_latex", "max_points"],
      "properties": {
        "semantic_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "order": {"type": "integer", "minimum": 1},
        "recall_cue": {"type": "string", "minLength": 1},
        "reference_latex": {"type": "string", "minLength": 1},
        "explanation": {"type": "string"},
        "max_points": {"$ref": "#/$defs/Decimal"},
        "criticality": {"enum": ["normal", "key"]},
        "knowledge_codes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "Part": {
      "type": "object",
      "required": ["part_key", "display_order", "response_type", "max_score", "prompt", "answer_spec"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "logical_part_id": {"type": "string", "format": "uuid"},
        "part_key": {"type": "string", "minLength": 1, "maxLength": 16},
        "display_order": {"type": "integer", "minimum": 1},
        "response_type": {"enum": ["single_choice", "multiple_choice", "integer", "decimal", "rational", "expression", "equation_set", "interval", "set", "matrix", "vector", "short_text", "proof", "derivation", "drawing"]},
        "max_score": {"$ref": "#/$defs/Decimal"},
        "prompt": {"$ref": "#/$defs/MathRichText"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/Option"}},
        "knowledge_codes": {"type": "array", "items": {"type": "string"}},
        "answer_spec": {"$ref": "#/$defs/AnswerSpec"},
        "rubric": {"$ref": "#/$defs/Rubric"},
        "solutions": {"type": "array", "items": {"$ref": "#/$defs/Solution"}},
        "reasoning_steps": {"type": "array", "items": {"$ref": "#/$defs/ReasoningStep"}}
      },
      "additionalProperties": false
    }
  }
}
