{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leetmath.dev/content-schema/v1/import-manifest.schema.json",
  "title": "LeetMath import batch manifest v1 (docs/05 §3)",
  "type": "object",
  "required": ["manifest_schema_version", "source_code", "dataset_id", "dataset_version", "locale",
               "rights_grant_ref", "input_format", "adapter_version", "normalizer_version", "files"],
  "properties": {
    "manifest_schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "sample_only": {"type": "boolean"},
    "source_code": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "locale": {"type": "string"},
    "rights_grant_ref": {"type": "string", "minLength": 1},
    "input_format": {"enum": ["jsonl", "csv", "json"]},
    "adapter_version": {"type": "string"},
    "normalizer_version": {"type": "string"},
    "dry_run": {"type": "boolean"},
    "sync_mode": {"enum": ["initial", "full", "incremental", "delta"]},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "record_count": {"type": "integer", "minimum": 0},
          "count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "curriculum_hints": {"type": "array"},
    "creator": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
